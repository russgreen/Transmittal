<Window x:Class="Transmittal.Desktop.Views.ImportDirectoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:import="clr-namespace:Transmittal.Library.Models.DirectoryImport;assembly=Transmittal.Library"
        mc:Ignorable="d"
        Title="Import Directory" Width="520" 
        MinWidth="400" MinHeight="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource WindowStyle}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Header}" TextWrapping="Wrap" FontWeight="SemiBold" />

        <TextBlock Grid.Row="1" Margin="0,5,0,5" TextWrapping="Wrap"
                   Text="Choose the companies and people to copy into this project's directory. Items already in this database are not selected, and are never duplicated." />

        <TreeView Grid.Row="2" ItemsSource="{Binding Source.Companies}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type import:ImportCompanyItem}" ItemsSource="{Binding People}">
                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,2,0,2">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExistsInTarget}" Value="True">
                                        <Setter Property="Foreground" Value="Gray" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type import:ImportPersonItem}">
                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" Margin="0,2,0,2">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExistsInTarget}" Value="True">
                                        <Setter Property="Foreground" Value="Gray" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,0">
            <Button Content="Select all" Padding="5,0,5,0" Command="{Binding SelectAllCommand}" />
            <Button Content="Select none" Padding="5,0,5,0" Margin="5,0,0,0" Command="{Binding SelectNoneCommand}" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Import" Padding="10,0,10,0" IsDefault="True" Command="{Binding ImportCommand}" />
                <Button Content="Cancel" Padding="10,0,10,0" Margin="5,0,0,0" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
