<Project Sdk="WixToolset.Sdk/7.0.1">
  <PropertyGroup>
    <!-- Accepts the WiX 7 OSMF EULA (build fails with WIX7015 without it). -->
    <AcceptEula>wix7</AcceptEula>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>Transmittal.$(VersionPrefix)</OutputName>
    <OutputPath>$(MSBuildProjectDirectory)\Transmittal-SetupFiles\</OutputPath>
    <!-- ICE43/ICE57: the desktop shortcut is keyed to the exe, as it was in the Advanced Installer package; ICE60: file language warnings for unversioned files -->
    <SuppressIces>ICE43;ICE57;ICE60</SuppressIces>
    <DefineConstants>$(DefineConstants);ProductVersion=$(VersionPrefix);SourceRoot=$(MSBuildProjectDirectory)\..\source\;RepoRoot=$(MSBuildProjectDirectory)\..\</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.1" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="transmittal_background.png" />
    <None Include="transmittal_banner.png" />
  </ItemGroup>
</Project>
